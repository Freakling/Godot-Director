# Godot
.godot/
# Godot 4.4+ writes a .uid next to each script. A real game commits them; this example ignores
# them so running it doesn't dirty the framework repo.
*.uid

# Godot Director's own files. In a real game they're committed; in this example they're installed
# by install.sh (selftest.sh does it), so the framework repo holds only one copy.
/.godot-director/
/.claude/
/.githooks/
/tools/check.sh
/tools/check.gd
/tools/test_case.gd
/tools/setup-clone.sh
/tools/release.sh
/tools/ui_capture.sh
/tools/ui_capture.gd
/tools/ui_catalog.gd
/tools/ui_lint.gd
/tools/ui_overlay.gd
/tools/ui_drawing.gd
/playtesting/README.md

# Godot Director
/tools/godot_bin.local
/.claude/settings.local.json
*.gdir-new
/builds/
/design/ui/captures/
