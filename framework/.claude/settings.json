{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "900000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  },
  "permissions": {
    "allow": [
      "Bash(bash tools/check.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(bash tools/check.sh)",
      "Bash(bash tools/ui_capture.sh *)",
      "Bash(bash tools/ui_capture.sh)",
      "Bash(bash tools/autoplay.sh *)",
      "Bash(bash tools/autoplay.sh)",
      "Bash(bash tools/log_review.sh *)",
      "Bash(bash tools/log_review.sh)",
      "Bash(bash tools/stories.sh --due)",
      "Bash(bash tools/prototype.sh *)",
      "Bash(git status)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(git -c *)",
      "PowerShell(git -c *)",
      "Bash(git config *)",
      "PowerShell(git config *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Bash(git push --force *)",
      "PowerShell(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git commit --no-verify *)",
      "PowerShell(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "PowerShell(git commit -n *)",
      "Bash(git *--output*)",
      "PowerShell(git *--output*)",
      "Bash(git *--no-index*)",
      "PowerShell(git *--no-index*)",
      "Bash(git *--ext-diff*)",
      "PowerShell(git *--ext-diff*)",
      "Bash(git commit *--file*)",
      "PowerShell(git commit *--file*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh\"",
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
